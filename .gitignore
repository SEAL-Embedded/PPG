# Python
__pycache__/
*.pyc
*.pyo

# Captured session data — user recordings, never check in
session_*/

# Dashboard runtime outputs — regenerated on each Analyze-all /
# sleepiness-summary run. Keep the directories (their READMEs are
# tracked) but never check in the per-run JSON snapshots.
MDPIdata/batch_analyses/*.json
MDPIdata/sleepiness_runs/*.json

# Nested historical clone (separate .git)
sqi/PPG/

# Local demo scratch — not part of the published pipeline
demo/

# Harness / agent lock files
.claude/scheduled_tasks.lock
.claude/tasks.lock

# Per-machine Claude Code permissions — local paths, never share
.claude/settings.local.json

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
